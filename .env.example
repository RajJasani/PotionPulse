# ==============================================================================
# PotionPulse — Environment Variable Reference
# Note: Copy this file to .env or .env.local for local development.
# NEVER commit real credentials or secrets to version control.
# ==============================================================================

# Runtime Environment
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Web Client Configuration
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Android / Mobile Configuration
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
ANDROID_APP_SCHEME=potionpulse

# CORS Allowlist (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (MongoDB Atlas / Local Replica Set)
MONGODB_URI=mongodb://localhost:27017/potionpulse?replicaSet=rs0

# Authentication & JWT Security
JWT_ACCESS_SECRET=replace-with-a-secure-random-64-character-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace-with-a-secure-random-64-character-secret
JWT_REFRESH_EXPIRATION=7d

# Google OAuth (Server-only exchange & Web Client ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Notifications (Optional extensions)
EMAIL_PROVIDER_API_KEY=
FCM_SERVICE_ACCOUNT=

# ML Forecasting Service (Optional isolated worker URL)
FORECAST_WORKER_URL=http://localhost:8000

# Error Monitoring (Optional)
SENTRY_DSN=

